#!/bin/sh

echo "Running Checkstyle..."
mvn checkstyle:check

if [ $? -ne 0 ]; then
  echo "Checkstyle failed — commit cancelled."
  exit 1
fi

STAGED_FEATURES=$(git diff --cached --name-only --diff-filter=ACM -- '*.feature')

if [ -n "$STAGED_FEATURES" ]; then
  echo "Running feature file format check..."
  sh scripts/check-feature-format.sh $STAGED_FEATURES

  if [ $? -ne 0 ]; then
    echo "Feature file formatting failed — commit cancelled."
    exit 1
  fi
fi