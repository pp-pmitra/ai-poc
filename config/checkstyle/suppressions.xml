<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suppressions PUBLIC
  "-//Checkstyle//DTD SuppressionFilter Configuration 1.2//EN"
  "https://checkstyle.org/dtds/suppressions_1_2.dtd">

<!--
  Baseline of violations that existed before Checkstyle was enforced
  (see checkstyle.xml's SuppressionFilter). These are grandfathered in
  so this pilot doesn't break the build on day one; new/modified code
  is still checked normally.

  To re-enable full enforcement:
    - remove one entry below once its file is cleaned up, or
    - delete this whole file to lift every suppression at once.
-->
